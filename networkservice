networkservice () {
    emulate -L zsh
    # macOS: hardware-port name, device, and hardware MAC, one per line.
    # Retain the original script's choice of the last active listed service.
    if [[ $OSTYPE != darwin* ]]; then
        print -u2 -r -- 'networkservice requires macOS.'
        return 2
    fi
    if (( ! $+commands[networksetup] || ! $+commands[ifconfig] )); then
        print -u2 -r -- 'networkservice requires networksetup and ifconfig.'
        return 2
    fi
    local services line device port details mac_info
    local currentservice='' currentdevice='' currentmac=''
    local -a match mbegin mend
    services=$(command networksetup -listnetworkserviceorder) || return 1
    while IFS= read -r line; do
        if [[ $line =~ '^[[:space:]]*[(]Hardware Port: (.*), Device: ([^)]*)[)]$' ]]; then
            port=$match[1]
            device=$match[2]
            [[ -n $device ]] || continue
            details=$(command ifconfig "$device" 2>/dev/null) || continue
            [[ $details == *'status: active'* ]] || continue
            currentservice=$port
            currentdevice=$device
        fi
    done <<< "$services"
    if [[ -z $currentservice ]]; then
        print -u2 -r -- 'Could not find an active network service.'
        return 1
    fi
    # Read the hardware address, independently of private Wi-Fi addressing.
    mac_info=$(command networksetup -getmacaddress "$currentdevice" 2>/dev/null) || {
        print -u2 -r -- "Could not read the hardware MAC address for $currentdevice."
        return 1
    }
    if [[ $mac_info =~ 'Ethernet Address:[[:space:]]*([[:xdigit:]]{2}(:[[:xdigit:]]{2}){5})([[:space:]]|$)' ]]; then
        currentmac=${(L)match[1]}
    fi
    if [[ -z $currentmac || $currentmac == 00:00:00:00:00:00 || $currentmac == 02:00:00:00:00:00 || $currentmac == ff:ff:ff:ff:ff:ff ]]; then
        print -u2 -r -- "macOS did not provide a usable hardware MAC address for $currentdevice."
        return 1
    fi
    print -r -- "$currentservice"
    print -r -- "$currentdevice"
    print -r -- "$currentmac"
}
