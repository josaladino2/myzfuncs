mkuserbashbk () {
( pushd ~ > /dev/null 2>&1
	printf "$(fg_color cyan "	UserFilesbashbk.tgz")..."
	tar -cvzhf UserFilesbashbk.tgz -X UserFiles-bashExclude -T UserFiles-bashInclude >mkuserfilesbashbk.out
	printf "$(fg_color white " Done")\n"
	popd > /dev/null 2>&1
	dirs -c > /dev/null 2>&1
	) 2>mkuserfilesbk.err
}
