get_fcn_list () {
    command -v textfmt >/dev/null 2>&1 || { print -u2 "textfmt is required"; return 127; }
	local Cols=1
	local Sort='Y'
	local ExText=''
	while [[ "${1:0:2}" =~ .*"-".* ]]; do
		case ${1:0:2} in
		'-h')	echo "$(fg_color red1 \"Usage:\") ${funcstack[1]} [-h] [-c6] [-v'^bg_\|^fg_']"
					return 0
		;;
		'-n')	Sort=''
					shift
		;;
		'-c') Cols=${1:2}
					shift
		;;
		'-s')	ExText="${1:2}"
					shift
		;;
		esac
	done
	if [ -z ${Sort} ]; then
		if [ -z ${ExText} ]; then
			awk '/^[a-z|0-9].*\(\)/{print $1}' ${myzfuncsfile} | command textfmt --columns --count "${Cols}" --width 80
		else
			awk '/^[a-z|0-9].*\(\)/{print $1}' ${myzfuncsfile} | ggrep -E "${ExText}" | command textfmt --columns --count "${Cols}" --width 80
		fi
	else
		if [ -z ${ExText} ]; then
			awk '/^[a-z|0-9].*\(\)/{print $1}' ${myzfuncsfile} | sort | command textfmt --columns --count "${Cols}" --width 80
		else
			awk '/^[a-z|0-9].*\(\)/{print $1}' ${myzfuncsfile} | ggrep -E "${ExText}" | sort | command textfmt --columns --count "${Cols}" --width 80
		fi
	fi
}
