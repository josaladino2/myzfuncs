mkuserbk () {
	(
		pushd ~ > /dev/null 2>&1
		printf "$(fg_color cyan "	UserFilesbk.tgz")..."
		tar -cvzhf UserFilesbk.tgz -X UserFiles-Exclude -T UserFiles-Include > mkuserfilesbk.out
		printf "$(fg_color white " Done")
"
		popd > /dev/null 2>&1
		dirs -c > /dev/null 2>&1
	) 2> mkuserfilesbk.err
}
