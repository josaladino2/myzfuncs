indent () {
    if [[ ${1-} == -h || ${1-} == --help ]]; then
        print -r -- 'Usage: indent [spaces=2] [multiplier=1] < input'
        return 0
    fi
    local spaces=${1:-2} multiplier=${2:-1}
    if [[ $spaces != <-> || $multiplier != <-> ]] ||
       (( ${#spaces} > 3 || ${#multiplier} > 3 || spaces > 84 || multiplier > 84 )); then
        print -u2 -r -- 'indent: spaces and multiplier must be integers from 0 to 84.'
        return 2
    fi
    command textfmt --indent --spaces "$(( 10#$spaces * 10#$multiplier ))"
}
