findlarger () {
    emulate -L zsh
    if (( $# == 1 )) && [[ $1 == --help || $1 == -h ]]; then
        print -r -- 'Usage: findlarger BYTES'
        print -r -- 'List regular files below . whose logical size is strictly greater than BYTES.'
        print -r -- 'Includes hidden files; does not follow symlinks. Read-only; requires find.'
        return 0
    fi
    if (( $# != 1 )) || [[ $1 != <-> ]]; then
        print -u2 -r -- 'Usage: findlarger BYTES (one nonnegative integer; bytes, not units)'
        return 2
    fi
    command find . -type f -size "+${1}c"
}
