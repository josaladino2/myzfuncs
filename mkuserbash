mkuserbash () {
( pushd ~ > /dev/null 2>&1
	printf "$(fg_color cyan "	UserFilesbash.tgz")..."
	tar -cvzhf UserFilesbash.tgz -X UserFiles-bashExclude -T UserFiles-bashInclude >mkuserfilesbash.out
	printf "$(fg_color white " Done")\n"
	popd > /dev/null 2>&1
	dirs -c > /dev/null 2>&1
	) 2>mkuserfilesbk.err
}
