showfgcolors () {
    emulate -L zsh
    # Keep the older -n / -cN palette-browser options working.
    local -i columns=0
    while (( $# )); do
        case $1 in
            -n) shift ;;
            -c[1-9]|-c[1-9][0-9]) columns=${1#-c}; shift ;;
            *) print -u2 -r -- 'Usage: showfgcolors [-n] [-c3..6]'; return 2 ;;
        esac
    done
    autoload -Uz _joe_color_palette fg_color
    (( ${+_joe_color_names} )) || _joe_color_palette
    if (( columns )); then
        (( columns < 3 )) && columns=3
        (( columns > 6 )) && columns=6
        local shade
        local -i width=0
        for shade in "${(@k)_joe_color_names}"; do
            (( ${#shade} > width )) && width=${#shade}
        done
        local COLUMNS=$(( (width + 2) * columns ))
    fi
    fg_color
}
