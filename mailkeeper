mailkeeper () {
    emulate -L zsh
    local program="$HOME/bin/mailkeeper"
    if [[ ! -x "$program" ]]; then
        print -u2 -- "Mailkeeper is not installed: $program. Update your bin repository first."
        return 1
    fi
    # Account YAML selects the server and mail root; --local/--ssh may override it.
    "$program" --account joe@bram.net "$@"
}
